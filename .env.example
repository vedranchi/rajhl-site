# ─── Payload CMS ────────────────────────────────────────────────────────────
# Long random string used to sign/encrypt tokens. Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Use the connection-pooler URI on Vercel (serverless).
# Set this locally only. On Vercel the Supabase integration injects POSTGRES_URL
# instead (it never creates DATABASE_URL); payload.config.ts falls back to it.
DATABASE_URL=
# Production only, and not set by hand: the Supabase↔Vercel integration injects
# it, and pgConnectionString() reads it when DATABASE_URL is absent. Listed here
# because the app reads it; leave it unset locally.
# POSTGRES_URL=

# ─── Applicant beat uploads (Supabase Storage) ──────────────────────────────
# The Private Telegram form takes three mp3s per application. They are uploaded
# straight from the browser to a private bucket using signed URLs minted by the
# server, so Vercel's lack of a local disk never matters and the audio never
# passes through a server action (Next caps action bodies at 1 MB).
# Project Settings → API in the Supabase dashboard. The service-role/secret key
# bypasses row-level security: server-side only, never in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to "invite-tracks". The bucket must be private and is set
# to enforce a 20 MB cap and an audio/mpeg allow-list of its own.
INVITE_TRACKS_BUCKET=
# Optional, used by scripts/purge-invite-tracks.mjs. Defaults to 90.
RETENTION_DAYS=

# There are still no Payload *upload collections*: uploads go to the bucket
# above rather than through Payload, so @payloadcms/storage-s3 and its
# S3_BUCKET / S3_ENDPOINT / S3_REGION / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# vars remain unnecessary. If a Media collection ever returns, they come back.

# ─── Invite-request emails (Resend) ─────────────────────────────────────────
# Sends the Private Telegram request notifications to the owner.
# Create a key at https://resend.com/api-keys. Without these the invite form
# fails soft ("temporarily unavailable") — the site still builds and runs.
RESEND_API_KEY=
# Where notifications go (the client's inbox).
INVITE_NOTIFY_TO=
# Verified sender. Until the client's domain is verified in Resend, leave unset
# to use the default onboarding sender (delivers to the Resend account owner).
INVITE_FROM="Inner Circle <invites@lukarajhl.com>"
# Optional: max invite-form submissions per IP per window (defaults below).
INVITE_RATE_LIMIT=3
INVITE_RATE_WINDOW_MS=3600000
# Optional: window in which a repeat submit from the same Instagram handle is
# marked a "duplicate" lead (stored, but no owner email is sent). Default 24h.
INVITE_DEDUPE_WINDOW_MS=86400000

# ─── Catalogue refresh script ───────────────────────────────────────────────
# scripts/fetch-beatstars.mjs refuses to write a catalogue that lost more than
# 20% of its beats, so a degraded fetch cannot overwrite good data. Set to 1 to
# override, and only when the drop is real.
# ALLOW_CATALOGUE_SHRINK=1
